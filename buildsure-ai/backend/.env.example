# SQLite by default; swap for Postgres in production
DATABASE_URL=sqlite:///./buildsure.db
# DATABASE_URL=postgresql+psycopg2://buildsure:buildsure@localhost:5432/buildsure

# Notification channels (left blank = log-only mode)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
TEAMS_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
SMS_API_KEY=

# Escalation thresholds
CRITICAL_RISK_SCORE=75
ESCALATION_SEVERITY=critical
